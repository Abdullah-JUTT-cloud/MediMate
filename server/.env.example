# ─── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me
MONGODB_URI=mongodb://localhost:27017/medalerto

# ─── Email (Brevo HTTPS REST API) ────────────────────────────────────────────
# API key from your Brevo account (Settings → SMTP & API → API Keys). Sent in
# the `api-key` header of POST https://api.brevo.com/v3/smtp/email.
BREVO_API_KEY=
# Sender address used in the From: header (must be verified in your Brevo
# account under Senders & Domains before dispatching).
SENDER_EMAIL=hello@medalerto.me
# Display name shown in the From: header.
FROM_NAME=MedAlerto

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── WhatsApp (Meta) ─────────────────────────────────────────────────────────
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# ─── Ops ─────────────────────────────────────────────────────────────────────
RUN_INDEX_MIGRATION=false
