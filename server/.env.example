# ─── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me
MONGODB_URI=mongodb://localhost:27017/medalerto

# ─── Email (SMTP via Brevo relay) ────────────────────────────────────────────
# Sender address actually used in the From: header (must be verified in your
# Brevo account under Senders & Domains before dispatching).
SENDER_EMAIL=hello@medalerto.me
# Legacy/alternate key the sender address can also be read from.
EMAIL_USER=hello@medalerto.me
# Display name shown in the From: header.
FROM_NAME=MedAlerto
# SMTP relay host and port (Brevo defaults).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP relay credentials from your Brevo account (Settings → SMTP & API).
SMTP_USER=
SMTP_PASS=
# Legacy/alternate key the SMTP password can also be read from.
EMAIL_PASS=

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── WhatsApp (Meta) ─────────────────────────────────────────────────────────
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# ─── Ops ─────────────────────────────────────────────────────────────────────
RUN_INDEX_MIGRATION=false
