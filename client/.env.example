# ─── MedAlerto client SEO configuration ─────────────────────────────────────
# Copy to client/.env and fill in real values before production builds.
# Vite injects %VITE_*% placeholders found in client/index.html.

# Base URL of the API origin (used by the SPA for all axios calls).
# VITE_API_URL=https://api.medalerto.me/api

# NOTE: the canonical origin is intentionally hard-coded to
# https://medalerto.me (client/src/seo/seoConfig.js) so staging or local
# preview builds can never leak non-production canonical URLs into search
# indexes. Do not override it per environment.

# Google Search Console HTML-tag verification token.
# Google Search Console → Settings → Verification → HTML tag → copy the
# content value (e.g. "abc123XYZ...") into VITE_GOOGLE_SITE_VERIFICATION.
VITE_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (starts with G-).
# GA4 boots only when a valid G-XXXXXXXX ID is configured; otherwise every
# analytics call in the SPA becomes a no-op.
VITE_GA4_MEASUREMENT_ID=
